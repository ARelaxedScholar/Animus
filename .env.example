# Animus Configuration
# Copy this to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgres://animus:animus@localhost:5432/animus

# =============================================================================
# OBJECT STORAGE (S3-compatible)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=animus-assets
S3_REGION=us-east-1

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google Gemini (Used for Script Judging and Imagen "Nano Banana" Thumbnails)
GEMINI_API_KEY=your_gemini_api_key

# =============================================================================
# TEXT-TO-SPEECH
# =============================================================================
# Provider: elevenlabs, qwen3, openai, coqui, piper
TTS_PROVIDER=elevenlabs

# ElevenLabs (cloud, high quality)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_chosen_voice_id
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# Qwen3-TTS (open-source, self-hosted - OpenAI-compatible API)
# Run with: https://github.com/QwenLM/Qwen2-Audio or similar server
QWEN3_API_URL=http://localhost:8000/v1
QWEN3_API_KEY=
QWEN3_VOICE=default

# OpenAI TTS (cloud)
OPENAI_TTS_API_KEY=your_openai_api_key
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_MODEL=tts-1-hd

# Local TTS (Coqui or Piper)
LOCAL_TTS_MODEL_PATH=/path/to/model
LOCAL_TTS_SPEAKER_ID=

# Common TTS settings
TTS_SPEED=1.0

# =============================================================================
# VIDEO ASSETS
# =============================================================================
# Pexels (stock footage)
PEXELS_API_KEY=your_pexels_api_key

# Stable Diffusion (optional, for AI-generated visuals)
# Can be local ComfyUI or a cloud API
SD_API_URL=http://localhost:7860
SD_API_KEY=

# Leonardo.ai (optional, for AI-generated images)
LEONARDO_API_KEY=your_leonardo_api_key

# Freesound.org (optional, for sound effects)
FREESOUND_API_KEY=your_freesound_api_key

# Asset Collection Settings
ASSET_MIN_CLIPS_PER_SECTION=3

# Asset Validation Settings
ASSET_MAX_RETRIES=3
ASSET_MIN_FILE_SIZE_KB=100
ASSET_VALIDATE_WITH_FFPROBE=true
ASSET_FALLBACK_TO_IMAGES=true

# =============================================================================
# YOUTUBE
# =============================================================================
# OAuth2 credentials from Google Cloud Console
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# =============================================================================
# CHANNEL CONFIGURATION
# =============================================================================
CHANNEL_NAME=Excelsior Academy
CHANNEL_TAGLINE=Wisdom for the journey upward

# =============================================================================
# CONTENT STRATEGY
# =============================================================================
# Target video duration in minutes
TARGET_DURATION_MIN=12
TARGET_DURATION_MAX=20

# Videos per week
VIDEOS_PER_WEEK=4

# =============================================================================
# SCRIPT SELF-IMPROVEMENT
# =============================================================================
# Enable the self-improvement loop
SCRIPT_IMPROVEMENT_ENABLED=true
# Number of initial script candidates to generate in parallel
SCRIPT_IMPROVEMENT_CANDIDATES=3
# Minimum score (1.0-10.0) to accept without refinement
SCRIPT_IMPROVEMENT_THRESHOLD=9.0
# Maximum refinement iterations before accepting best available
SCRIPT_IMPROVEMENT_MAX_ITERATIONS=10
# Number of iterations without improvement before giving up early
SCRIPT_IMPROVEMENT_STAGNATION_THRESHOLD=3
# Total timeout for the entire self-improvement process (seconds)
SCRIPT_IMPROVEMENT_TIMEOUT=1800

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Discord webhook for notifications (optional)
DISCORD_WEBHOOK_URL=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# =============================================================================
# DAEMON
# =============================================================================
# Control API port
CONTROL_API_PORT=8080

# API Security (for remote farm control)
ANIMUS_API_KEY=your_secure_api_key_here
ANIMUS_SERVER_URL=http://your-laptop-ip:8080

# Log level
RUST_LOG=animus=info,orichalcum=info
