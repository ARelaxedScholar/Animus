# Animus Secrets
# Copy this to your secrets file (e.g., /etc/animus/secrets.env)
# DO NOT commit this file to git!

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgres://animus:animus@localhost:5432/animus

# =============================================================================
# OBJECT STORAGE (S3-compatible)
# =============================================================================
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# =============================================================================
# LLM PROVIDERS
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# TEXT-TO-SPEECH
# =============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=ib3Wv1WIXhGL105hBmF6
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

QWEN3_API_KEY=your_qwen3_api_key_here

OPENAI_TTS_API_KEY=your_openai_tts_api_key_here

LOCAL_TTS_MODEL_PATH=/home/user/voices/mv2.onnx

# =============================================================================
# VIDEO ASSETS
# =============================================================================
PEXELS_API_KEY=your_pexels_api_key_here

SD_API_URL=http://localhost:7860
SD_API_KEY=your_sd_api_key_here

LEONARDO_API_KEY=your_leonardo_api_key_here

FREESOUND_API_KEY=your_freesound_api_key_here

# =============================================================================
# YOUTUBE
# =============================================================================
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# =============================================================================
# NOTIFICATIONS
# =============================================================================
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_pass_here
NOTIFICATION_EMAIL=your_notification_email_here
