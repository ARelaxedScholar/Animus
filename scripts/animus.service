[Unit]
Description=Animus Autonomous YouTube Content Farm
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/Animus
# Run inside the nix development environment
ExecStart=/usr/bin/nix develop --command cargo run
Restart=always
RestartSec=5

# Environment variables can be loaded from .env file
# or specified here if needed
Environment=RUST_LOG=animus=info,orichalcum=info
Environment=DATABASE_URL=postgres://animus:animus@localhost:5432/animus

[Install]
WantedBy=multi-user.target
